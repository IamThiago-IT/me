generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public"]
}

model User {
  id    Int     @id @default(autoincrement())
  email String  @unique
  name  String?
  posts Post[]

  @@schema("public")
}

model Post {
  id        Int     @id @default(autoincrement())
  title     String
  content   String?
  published Boolean @default(false)
  author    User    @relation(fields: [authorId], references: [id])
  authorId  Int

  @@schema("public")
}

model Certificate {
  id            Int       @id @default(autoincrement())
  title         String
  issuer        String
  issuerUrl     String?
  description   String?
  credentialUrl String?
  imageUrl      String?
  issuedAt      DateTime?
  expiresAt     DateTime?
  order         Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@schema("public")
}
