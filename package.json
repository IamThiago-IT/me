{
  "name": "me",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "biome": "biome check",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "test:browser": "vitest --environment=jsdom",
    "playwright": "playwright test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "pages:deploy": "wrangler pages deploy .next",
    "postinstall": "prisma generate --schema=./prisma/schema/schema.prisma && prisma generate --schema=./prisma/schema/services.prisma",
    "vercel-build": "prisma generate --schema=./prisma/schema/schema.prisma && prisma generate --schema=./prisma/schema/services.prisma && prisma migrate deploy --schema=./prisma/schema/schema.prisma && prisma migrate deploy --config=./prisma.config.services.ts && next build",
    "db:generate": "prisma generate --schema=./prisma/schema/schema.prisma && prisma generate --schema=./prisma/schema/services.prisma",
    "db:format": "prisma format --schema=./prisma/schema/schema.prisma && prisma format --schema=./prisma/schema/services.prisma",
    "db:format:public": "prisma format --schema=./prisma/schema/schema.prisma",
    "db:format:services": "prisma format --schema=./prisma/schema/services.prisma",
    "db:migrate": "prisma migrate dev --schema=./prisma/schema/schema.prisma",
    "db:migrate:services": "prisma migrate dev --schema=./prisma/schema/services.prisma",
    "db:deploy": "prisma migrate deploy --schema=./prisma/schema/schema.prisma && prisma migrate deploy --schema=./prisma/schema/services.prisma",
    "db:studio": "prisma studio --schema=./prisma/schema/schema.prisma",
    "db:studio:services": "prisma studio --schema=./prisma/schema/services.prisma"
  },
  "dependencies": {
    "@polar-sh/nextjs": "^0.9.6",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^13.2.0",
    "lucide-react": "^1.41.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "react-signature-canvas": "1.1.0-alpha.2",
    "resend": "^6.26.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@calcom/embed-react": "^1.5.3",
    "@chromatic-com/storybook": "5.3.1",
    "@eslint/eslintrc": "^3.3.7",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/addon-onboarding": "10.6.0",
    "@storybook/addon-vitest": "10.6.0",
    "@storybook/manager-api": "^8.6.14",
    "@storybook/nextjs-vite": "^10.6.0",
    "@storybook/theming": "^8.6.14",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@vitest/browser": "^5.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "dotenv": "^17.4.2",
    "eslint": "10.9.1",
    "eslint-config-next": "16.3.4",
    "eslint-plugin-storybook": "10.6.0",
    "playwright": "^1.62.1",
    "prisma": "^7.10.0",
    "react-syntax-highlighter": "^16.1.1",
    "sqlite3": "^6.0.1",
    "storybook": "10.6.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "wrangler": "^4.129.0"
  },
  "eslintConfig": {
    "extends": [
      "plugin:storybook/recommended"
    ]
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.18",
      "@types/react-dom": "19.2.7"
    }
  }
}
